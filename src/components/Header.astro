---
import { Image } from 'astro:assets'
import logoMark from '../assets/images/logo-mark.png'
import Container from './Container.astro'
import { primaryCta } from '../data/site'

const navItems = [
  { href: '#service', label: 'サービス' },
  { href: '#pricing', label: '料金' },
  { href: '#flow', label: '流れ' },
  { href: '#faq', label: 'FAQ' },
]
---

<header id="site-header" class="fixed inset-x-0 top-0 z-40">
  <Container class="flex h-16 items-center justify-between">
    <a href="#top" class="flex items-center gap-3" aria-label="Private salon 結 -Yui- トップへ">
      <Image
        src={logoMark}
        alt=""
        aria-hidden="true"
        width={44}
        height={44}
        loading="eager"
        class="h-11 w-11 shrink-0"
      />
      <span class="flex flex-col leading-tight">
        <span class="font-display text-[11px] tracking-wide text-ink-muted">Private salon</span>
        <span class="text-base font-bold text-ink">結 -Yui-</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-bold text-ink transition-colors hover:text-rose-deep"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={primaryCta.href}
      class="hidden rounded-full bg-rose-brand px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-rose-deep sm:inline-flex"
    >
      {primaryCta.shortLabel}
    </a>
  </Container>
</header>
