---
import { Image } from 'astro:assets'
import logoMark from '../assets/images/logo-mark.png'
import Container from './Container.astro'
import { site } from '../data/site'

const year = new Date().getFullYear()
---

<footer class="border-t border-line bg-white py-16 text-ink">
  <div id="footer-sentinel" aria-hidden="true"></div>
  <Container>
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="flex items-start gap-3">
        <Image
          src={logoMark}
          alt=""
          aria-hidden="true"
          width={130}
          height={130}
          densities={[1, 2, 3]}
          loading="lazy"
          class="h-[130px] w-[130px] shrink-0"
        />
        <div>
          <p class="font-bold">{site.businessName}</p>
          <p class="mt-1 text-sm text-ink-muted">{site.serviceArea}</p>
        </div>
      </div>

      <div class="flex flex-col gap-2 text-sm">
        <a href={`mailto:${site.email}`} class="font-bold text-rose-deep hover:underline">
          {site.email}
        </a>
        <a href="/privacy/" class="text-ink-muted hover:text-rose-deep hover:underline">
          プライバシーポリシー
        </a>
        <a
          href={site.reservationSiteUrl}
          class="text-ink-muted hover:text-rose-deep hover:underline"
        >
          既にご契約中の企業様はこちら
        </a>
      </div>
    </div>

    <p class="mt-10 text-xs text-ink-muted">© {year} {site.businessName}</p>
  </Container>
</footer>
